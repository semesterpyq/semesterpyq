rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public website settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Universities
    match /universities/{universityId} {
      allow read: if true;
      allow write: if true;
    }

    // Courses
    match /courses/{courseId} {
      allow read: if true;
      allow write: if true;
    }

    // Years
    match /years/{yearId} {
      allow read: if true;
      allow write: if true;
    }

    // Semesters
    match /semesters/{semesterId} {
      allow read: if true;
      allow write: if true;
    }

    // Subjects
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if true;
    }

    // Question Papers
    match /papers/{paperId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

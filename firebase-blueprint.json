{
  "entities": {
    "settings": {
      "title": "SiteSettings",
      "description": "Global website branding, header, contacts, and ad configurations",
      "type": "object",
      "properties": {
        "site_name": { "type": "string", "maxLength": 100 },
        "site_tagline": { "type": "string", "maxLength": 200 },
        "tagline": { "type": "string", "maxLength": 200 },
        "college_address": { "type": "string", "maxLength": 300 },
        "contact_email": { "type": "string", "maxLength": 150 },
        "contact_phone": { "type": "string", "maxLength": 50 },
        "logo_url": { "type": "string", "maxLength": 500 },
        "favicon_url": { "type": "string", "maxLength": 500 },
        "hero_title": { "type": "string", "maxLength": 150 },
        "hero_subtitle": { "type": "string", "maxLength": 400 },
        "notice_ticker": { "type": "string", "maxLength": 300 },
        "about_text": { "type": "string", "maxLength": 2000 },
        "seo_title": { "type": "string", "maxLength": 150 },
        "seo_description": { "type": "string", "maxLength": 300 },
        "ad_banner_header": { "type": "boolean" },
        "ad_banner_sidebar": { "type": "boolean" },
        "ad_banner_paper": { "type": "boolean" }
      }
    },
    "university": {
      "title": "University",
      "description": "University or institution entity",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 150 },
        "code": { "type": "string", "maxLength": 50 },
        "logo_url": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 1000 },
        "is_active": { "type": "boolean" },
        "display_order": { "type": "number" },
        "created_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name"]
    },
    "course": {
      "title": "Course",
      "description": "Academic course under a university",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "university_id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 150 },
        "code": { "type": "string", "maxLength": 50 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "display_order": { "type": "number" },
        "is_published": { "type": "boolean" },
        "created_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "university_id", "name"]
    },
    "year": {
      "title": "Year",
      "description": "Academic year level (1st Year, 2nd Year, 3rd Year)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "university_id": { "type": "string", "maxLength": 100 },
        "course_id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "year_number": { "type": "number" },
        "slug": { "type": "string", "maxLength": 100 },
        "display_order": { "type": "number" },
        "is_published": { "type": "boolean" },
        "created_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "university_id", "course_id", "name"]
    },
    "semester": {
      "title": "Semester",
      "description": "Semester entity under a course year",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "university_id": { "type": "string", "maxLength": 100 },
        "course_id": { "type": "string", "maxLength": 100 },
        "year_id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "semester_number": { "type": "number" },
        "display_order": { "type": "number" },
        "is_published": { "type": "boolean" },
        "created_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "university_id", "course_id", "year_id", "name"]
    },
    "subject": {
      "title": "Subject",
      "description": "Subject or paper topic entity",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "university_id": { "type": "string", "maxLength": 100 },
        "course_id": { "type": "string", "maxLength": 100 },
        "year_id": { "type": "string", "maxLength": 100 },
        "semester_id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 200 },
        "code": { "type": "string", "maxLength": 50 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "display_order": { "type": "number" },
        "is_published": { "type": "boolean" },
        "created_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "university_id", "course_id", "year_id", "semester_id", "name"]
    },
    "paper": {
      "title": "QuestionPaper",
      "description": "Previous year question paper record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "university_id": { "type": "string", "maxLength": 100 },
        "course_id": { "type": "string", "maxLength": 100 },
        "year_id": { "type": "string", "maxLength": 100 },
        "semester_id": { "type": "string", "maxLength": 100 },
        "subject_id": { "type": "string", "maxLength": 100 },
        "paper_year": { "type": "number" },
        "exam_year": { "type": "number" },
        "title": { "type": "string", "maxLength": 250 },
        "exam_session": { "type": "string", "maxLength": 100 },
        "paper_code": { "type": "string", "maxLength": 50 },
        "total_marks": { "type": "number" },
        "duration": { "type": "string", "maxLength": 50 },
        "file_name": { "type": "string", "maxLength": 250 },
        "file_url": { "type": "string", "maxLength": 2000000 },
        "file_size": { "type": "string", "maxLength": 50 },
        "is_published": { "type": "boolean" },
        "view_count": { "type": "number" },
        "download_count": { "type": "number" },
        "created_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "university_id", "course_id", "year_id", "semester_id", "subject_id", "title"]
    }
  },
  "firestore": {
    "/settings/config": {
      "schema": "settings",
      "description": "Global website settings document"
    },
    "/universities/{universityId}": {
      "schema": "university",
      "description": "Collection of universities and institutions"
    },
    "/courses/{courseId}": {
      "schema": "course",
      "description": "Collection of academic courses"
    },
    "/years/{yearId}": {
      "schema": "year",
      "description": "Collection of academic year levels"
    },
    "/semesters/{semesterId}": {
      "schema": "semester",
      "description": "Collection of academic semesters"
    },
    "/subjects/{subjectId}": {
      "schema": "subject",
      "description": "Collection of course subjects"
    },
    "/papers/{paperId}": {
      "schema": "paper",
      "description": "Collection of question papers and PDF links"
    }
  }
}
